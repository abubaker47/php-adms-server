[Unit]
Description=ADMS Server - Attendance Device Management System
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/adms-server
Environment="ADMS_API_KEY=your-secure-api-key"
ExecStart=/usr/bin/php -S 0.0.0.0:8080 -t public
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/adms-server/database /var/www/adms-server/logs

[Install]
WantedBy=multi-user.target
